{
  "manifest_version": 3,
  "name": "Resonate Hunter",
  "version": "1.0.0",
  "description": "The Hunter - Capture job descriptions and send them to the Resonate Command Center",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
